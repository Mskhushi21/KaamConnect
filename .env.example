# GEMINI_API_KEY: Optional in this build; injected at runtime if needed.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret key used to sign session cookies and CSRF tokens.
# Change this to a long random string in production.
SESSION_SECRET="kaamconnect-dev-session-secret-change-in-production"

# SQLITE_DB_PATH: Optional custom path to the SQLite database file.
# Defaults to ./data/kaamconnect.db
SQLITE_DB_PATH="./data/kaamconnect.db"

# ADMIN_EMAIL / ADMIN_PASSWORD: Optional bootstrap admin credentials on first run.
ADMIN_EMAIL="admin@kaamconnect.in"
ADMIN_PASSWORD="Admin@KaamConnect2026"
